# OpenRouter (required for all AI features - chat and image generation)
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_REFERRER=https://dev.visibible.com
OPENROUTER_TITLE=visibible
# Optional: main image-generation upstream timeout in milliseconds (default: 45000)
# OPENROUTER_IMAGE_TIMEOUT_MS=45000

# Image generation feature flags
# Set to true to enable image generation
ENABLE_IMAGE_GENERATION=false
# Who the image engine admits once ENABLE_IMAGE_GENERATION is on: public (default), owner (admins only, to preview a work
# or style) or disabled. Needs works/<id>/work.json, brief.json and the work's registered, active analysis.
# See llm/context/IMAGE-GENERATION.md.
# GENERIC_ENGINE_MODE=public
# Optional single owner-controlled non-admin session for real guest billing checks in owner mode.
# GENERIC_ENGINE_OWNER_CHECK_SESSION_SHA256=<64-hex SHA-256 of SID; remove after release check>

# Convex (sessions, credits, image storage, and shared application state)
# For local development, point these at your DEV deployment.
# Keep production values in your hosting provider (e.g. Vercel), not in .env.local.
# Deployment name from Convex dashboard (e.g., 'dev:your-deployment-name')
# Used by Convex CLI tooling (local/CI), not required by Next.js runtime on Vercel.
CONVEX_DEPLOYMENT=
# Dev runtime target example:
#   NEXT_PUBLIC_CONVEX_URL=https://api.dev.visibible.com
# Prod runtime target example:
#   NEXT_PUBLIC_CONVEX_URL=https://api.visibible.com
NEXT_PUBLIC_CONVEX_URL=
# Server secret for authenticating API route calls to Convex actions
# This prevents malicious clients from directly calling credit mutations
# Generate with: openssl rand -hex 32
CONVEX_SERVER_SECRET=

# Session management (required for credits system)
# Generate a secure random secret: openssl rand -base64 32
SESSION_SECRET=
# Session timeout policy (optional overrides)
# Idle timeout in minutes (allowed: 5-129600, default: 86400 = 60 days)
# SESSION_IDLE_TIMEOUT_MINUTES=86400
# Absolute timeout in hours (allowed: 4-8760, default: 8760 = 365 days)
# SESSION_ABSOLUTE_TIMEOUT_HOURS=8760
# Owner (admin) access ends 7 days after each admin login, whatever these are set to.
# Separate secret for IP hashing (defense in depth - if SESSION_SECRET leaks, IP hashes remain unpredictable)
# Generate with: openssl rand -base64 32
IP_HASH_SECRET=
# Proxy trust (recommended in production for accurate client IPs)
# See llm/workflow/PROXY_CONFIGURATION.md for detailed guidance
# TRUST_PROXY_PLATFORM=vercel
# TRUSTED_PROXY_IPS="203.0.113.10,203.0.113.0/24,2001:db8::/32"
# Temporary emergency override only (not recommended): bypasses production fail-fast
# when TRUST_PROXY_PLATFORM/TRUSTED_PROXY_IPS are unset.
# ALLOW_UNTRUSTED_PROXY_IN_PRODUCTION=true
# DEBUG_PROXY=true  # Enable proxy trust audit logging
# Public app URL (recommended in production for origin validation allowlist)
# Dev preview example: https://dev.visibible.com
# Production example: https://visibible.com
NEXT_PUBLIC_APP_URL=

# Ops endpoint auth (recommended in production)
# /api/metrics stays disabled unless one of these policies is configured.
# /api/readiness always returns a public summary, but detailed dependency checks
# require one of these policies.
# Generate bearer tokens with: openssl rand -hex 32
# METRICS_TOKEN=
# METRICS_IP_ALLOWLIST="203.0.113.10,203.0.113.11"
# READINESS_TOKEN=
# READINESS_IP_ALLOWLIST="203.0.113.10,203.0.113.11"

# Lightning payments (for credit purchases)
# LNURL-pay callback that creates invoices; <url>/check?id=<payment hash> reports their state
LNURL_PAY_URL=https://tower.taila60b27.ts.net:10000/lnurlp/pay

# Admin access (optional - for privileged users with unlimited access)
ADMIN_PASSWORD=your-secret-admin-password
# HMAC secret for admin password verification (any secure random value)
# Generate with: openssl rand -hex 32
ADMIN_PASSWORD_SECRET=

# Nostr auto-publishing (optional - for sharing generated images to Nostr)
# IMPORTANT: Set NOSTR_PRIVATE_KEY in the CONVEX DASHBOARD (Settings > Environment Variables),
# not in .env.local. Convex actions cannot read .env.local.
#
# NOSTR_PUBLISHING_ENABLED - Disabled unless exactly "true"; leave false during recovery.
# Set this in Convex too. Never re-enable with the exposed private key.
# NOSTR_PUBLISHING_ENABLED=false
# NOSTR_PRIVATE_KEY - Hex-encoded (64 chars) or nsec format
# NOSTR_RELAYS - Optional comma or newline separated relay URLs (must start with wss://)
# NOSTR_IMAGE_BASE_URL - Optional explicit public image base URL used in Nostr posts
# CONVEX_SITE_URL - Optional Convex HTTP Actions base URL fallback for image links
# Example:
# NOSTR_RELAYS=wss://relay.nostr.band,wss://nos.lol,wss://relay.damus.io,wss://relay.primal.net
#
# Note: CONVEX_CLOUD_URL is a built-in Convex system variable (no manual config needed).
# If NOSTR_RELAYS is not set, defaults are:
# wss://relay.nostr.band, wss://nos.lol, wss://relay.damus.io, wss://relay.primal.net

# Guest JWT bridge (RS256). Configure public values on Convex as well.
# See docs/agents/guest-auth.md for setup and rotation. Private JWK: Next.js ONLY.
GUEST_AUTH_ISSUER=
GUEST_AUTH_AUDIENCE=
GUEST_AUTH_JWKS=
GUEST_AUTH_PRIVATE_JWK=

# Enable video admission in Next.js; the matching Convex worker also needs OPENROUTER_API_KEY.
ENABLE_VIDEO_GENERATION=false
