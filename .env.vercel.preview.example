# Vercel Preview environment template.
# Set these in Vercel Project -> Settings -> Environment Variables (Preview).

# Public app URL for preview.
NEXT_PUBLIC_APP_URL=https://dev.visibible.com

# Proxy trust configuration for accurate client IP extraction on Vercel.
TRUST_PROXY_PLATFORM=vercel

# AI provider configuration.
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_REFERRER=https://dev.visibible.com
OPENROUTER_TITLE=visibible-preview
# Optional image pipeline tuning.
# OPENROUTER_IMAGE_TIMEOUT_MS=45000
# OPENROUTER_SCENE_PLANNER_MODEL=openai/gpt-oss-120b
# SCENE_PLANNER_TIMEOUT_MS=10000
# COST_EVENT_PERSIST_TIMEOUT_MS=1500
# Optional strict host allowlist for server-side image persistence fetches.
# IMAGE_FETCH_ALLOWLIST=openrouter.ai,*.openrouter.ai

# Feature flags.
ENABLE_IMAGE_GENERATION=true
ENABLE_SCENE_PLANNER=true

# Convex runtime target for preview.
# Recommended: point preview app traffic to Convex dev deployment.
CONVEX_SERVER_SECRET=your-dev-convex-server-secret
NEXT_PUBLIC_CONVEX_URL=https://api.dev.visibible.com
# Optional Convex HTTP Actions custom domain (configured in Convex):
# actions.dev.visibible.com

# Session security secrets (must be at least 32 chars).
# Vercel Flags discovery secret for preview QA and Toolbar overrides.
FLAGS_SECRET=generate-with-openssl-rand-base64-32
IP_HASH_SECRET=generate-with-openssl-rand-base64-32
SESSION_SECRET=generate-with-openssl-rand-base64-32

# Optional admin access for preview.
ADMIN_PASSWORD=optional-preview-admin-password
ADMIN_PASSWORD_SECRET=your-dev-admin-password-secret

# Optional Lightning payments (typically disabled in preview).
# LND_HOST=
# LND_INVOICE_MACAROON=
