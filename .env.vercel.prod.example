# Vercel Production environment template.
# Set these in Vercel Project -> Settings -> Environment Variables (Production).

# Public canonical app URL.
NEXT_PUBLIC_APP_URL=https://visibible.com

# Proxy trust configuration for accurate client IP extraction on Vercel.
TRUST_PROXY_PLATFORM=vercel

# AI provider configuration.
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_REFERRER=https://visibible.com
OPENROUTER_TITLE=visibible
# Optional strict host allowlist for server-side image persistence fetches.
# IMAGE_FETCH_ALLOWLIST=openrouter.ai,*.openrouter.ai

# Feature flags.
ENABLE_IMAGE_GENERATION=true
ENABLE_SCENE_PLANNER=true

# Convex runtime target for production.
# Must point at Convex prod deployment.
CONVEX_SERVER_SECRET=your-prod-convex-server-secret
NEXT_PUBLIC_CONVEX_URL=https://api.visibible.com
# Optional Convex HTTP Actions custom domain (configured in Convex):
# actions.visibible.com

# Session security secrets (must be at least 32 chars).
IP_HASH_SECRET=generate-with-openssl-rand-base64-32
SESSION_SECRET=generate-with-openssl-rand-base64-32

# Optional admin access for production.
ADMIN_PASSWORD=optional-production-admin-password
ADMIN_PASSWORD_SECRET=your-prod-admin-password-secret

# Optional Lightning payments.
# LND_HOST=
# LND_INVOICE_MACAROON=
