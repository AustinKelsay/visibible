# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
bun.lock
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
SECURITY-REVIEW.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.convex.dev.example
!.env.convex.prod.example
!.env.vercel.preview.example
!.env.vercel.prod.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Convex function metadata / specs (generated)
function_spec.json
*function_spec*.json

# Rebuilt offline from checked source snapshots (npm run works:import)
/works/*/work.json
# Reading-pass run state and draft briefs await the owner's brief PR (npm run works:read)
/works/*/.preparation/
/works/*/brief.draft.json
/works/*/brief.draft.review.json
# Image evaluation runs: outputs, state and reports are owner evidence, not source
/evals/images/runs/
# Release rehearsal results: observed outcomes attached to the release PR, not source
/evals/rehearsal/
