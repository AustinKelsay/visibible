  "sources": [
    {
      "unit": "1-chronicles-22-5",
      "quote": "David said, “Solomon my son is young and tender, and the house that is to be built for Yahweh must be exceedingly magnificent, of fame and of glory throughout all countries. I will therefore make preparation for it.” So David prepared abundantly before his death."
    },
    {
      "unit": "1-chronicles-23-1",
      "quote": "Now David was old and full of days; and he made Solomon his son king over Israel."
    },
    {
      "unit": "1-chronicles-29-28",
      "quote": "He died at a good old age, full of days, riches, and honor; and Solomon his son reigned in his place."
    },
    {
      "unit": "psalms-37-25",
      "quote": "I have been young, and now am old, yet I have not seen the righteous forsaken, nor his children begging for bread."
    },
    {
      "unit": "psalms-71-9",
      "quote": "Don’t reject me in my old age. Don’t forsake me when my strength fails."
    },
    {
      "unit": "psalms-71-18",
      "quote": "Yes, even when I am old and gray-haired, God, don’t forsake me, until I have declared your strength to the next generation, your might to everyone who is to come."
    }
  ],
