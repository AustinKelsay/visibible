function replay(phase: "canon" | "plan") {
  const row = phase === "canon" ? canonCall : planCall;
  return { id: READING_PASS_MODEL, complete: async (request: TextModelRequest) => {
    if (phase === "canon") canonReplayCalls++; else sceneReplayCalls++;
    assert.deepEqual(row.request.messages, [{ role: "system", content: request.system }, { role: "user", content: request.user }]);
    assert.equal(row.request.max_tokens, request.maxTokens);
    assert.deepEqual(row.request.response_format.json_schema, { name: request.schemaName, strict: true, schema: responseSchema(request.schema) });
    const response = row.response;
    return { content: response.choices[0].message.content, model: response.model, providerRequestId: response.id,
      finishReason: response.choices[0].finish_reason, usage: { promptTokens: response.usage.prompt_tokens, completionTokens: response.usage.completion_tokens, costUsd: response.usage.cost }, elapsedMs: 0 };
  } };
}
