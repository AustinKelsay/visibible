index 0000000..a40ca7a
--- /dev/null
+++ b/src/lib/__tests__/suite-blind-description.test.ts
@@ -0,0 +1,51 @@
+/** Exercise the real CLI and its serialized scorer packs without any providers. */
+import { execFileSync } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import { mkdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+
+const root = process.cwd();
+const legacy = { primarySubject: "Watson", action: "pauses", setting: "the pavement", secondaryElements: "a window", mood: "quiet", timeOfDay: "night", composition: "wide" };
+const description = "Watson pauses on the pavement, looking up at the lit window in the rain.";
+
+describe("blind scorer scene descriptions", () => {
+  it.each(["text", "image"])("preserves new and historical descriptions in the serialized %s pack", (tier) => {
+    const run = `scene-description-blind-test-${randomUUID()}`;
+    const runDir = path.join(root, "llm/releases", run);
+    const blobs = path.join(root, "evals/images/runs", run);
+    mkdirSync(runDir, { recursive: true });
+    try {
+      const imageFile = path.join(runDir, "source.png");
+      writeFileSync(imageFile, new Uint8Array([137, 80, 78, 71])); // blind copies bytes; it never decodes the image.
+      const snapshot = { works: { "holmes-adventures": { records: {
+        "entry:watson": { payload: { name: "Watson", entryKind: "character", hasForm: true } },
+        "section:s": { payload: { cast: [{ entryId: "watson" }] } },
+      } } } };
+      writeFileSync(path.join(runDir, "snapshot.json"), JSON.stringify(snapshot));
+      writeFileSync(path.join(runDir, "plan.json"), JSON.stringify({ tier, from: run, suite: "fixture", faults: "fixture" }));
+      const rows = [ { reference: "A", scene: { scene: description } }, { reference: "B", scene: legacy } ].map(({ reference, scene }) => ({
+        key: reference, caseId: reference, work: "holmes-adventures", sectionId: "s", style: "classical", split: "holdout",
+        outcome: tier === "text" ? "planned" : "image", context: { moment: { reference, text: "Watson looked up." }, previous: null, next: null },
+        prepared: { present: [{ entryId: "watson" }], plan: { present: ["watson"], ...scene } },
+        chosen: 1, attempts: [{ file: path.relative(root, imageFile) }],
+      }));
+      writeFileSync(path.join(runDir, "results.ndjson"), rows.map((row) => JSON.stringify(row)).join("\n") + "\n");
+      execFileSync(process.execPath, ["--import", "data:text/javascript,globalThis.fetch=()=>{throw new Error('Unexpected network call in blind test')}",
+        "--import", "tsx", "scripts/evals/suite.mts", "blind", "--run", run], { cwd: root, timeout: 20_000, stdio: "pipe" });
+      const pack = JSON.parse(readFileSync(path.join(runDir, "scoring/items-1.json"), "utf8")) as {
+        items: Array<{ reference: string; plan?: Record<string, unknown>; scene?: Record<string, unknown> }>;
+      };
+      expect(pack.items).toHaveLength(2);
+      const content = (reference: string) => {
+        const item = pack.items.find((entry) => entry.reference === reference)!;
+        return tier === "text" ? item.plan : item.scene;
+      };
+      expect(content("A")).toEqual({ ...(tier === "text" ? { selected: ["Watson"] } : {}), scene: description });
+      expect(content("B")).toEqual({ ...(tier === "text" ? { selected: ["Watson"] } : {}), ...legacy });
+    } finally {
+      rmSync(runDir, { recursive: true, force: true });
+      rmSync(blobs, { recursive: true, force: true });
+    }
+  });
+});
