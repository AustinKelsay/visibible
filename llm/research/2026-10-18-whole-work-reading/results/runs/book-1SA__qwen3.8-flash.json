:["battlefield"],"note":"Site of David vs Goliath"},{"id":"nob","name":"Nob","aliases":["city of priests"],"note":"Where David gets bread and sword"},{"id":"adullam_cave","name":"Cave of Adullam","aliases":["stronghold"],"note":"David's refuge with outlaws"},{"id":"keilah","name":"Keilah","aliases":["town"],"note":"City saved by David"},{"id":"wilderness_ziph","name":"Wilderness of Ziph","aliases":["woods","hill of Hachilah"],"note":"Area of pursuit"},{"id":"en_gedi","name":"En Gedi","aliases":["wilderness","caves"],"note":"Where David spares Saul"},{"id":"maon_carmel","name":"Maon/Carmel","aliases":["lands of Nabal"],"note":"Location of Nabal's estate"},{"id":"ziklag","name":"Ziklag","aliases":["city given to David"],"note":"David's base in Philistine territory"},{"id":"endor","name":"Endor","aliases":["woman's house"],"note":"Site of necromancy"},{"id":"mount_gilboa","name":"Mount Gilboa","aliases":["battlefield"],"note":"Site of Saul's death"},{"id":"beth_shan","name":"Beth Shan","aliases":["wall"],"note":"Where Saul's body is displayed"},{"id":"jabesh_gilead","name":"Jabesh Gilead","aliases":["city"],"note":"Rescued by Saul, buries Saul"}],"sections":[{"start":"1:1","end":"2:11","title":"Birth and Dedication of Samuel","setting":["ramah","shiloh"],"on_stage_named":["elkanah","hannah","peninnah","eli","samuel"],"on_stage_unnamed":[],"mentioned_only":["yahweh"]},{"start":"2:12","end":"3:21","title":"Corruption of Eli's Sons and Call of Samuel","setting":["shiloh"],"on_stage_named":["eli","hophni","phinehas_eli","samuel"],"on_stage_unnamed":["man_of_god"],"mentioned_only":["yahweh"]},{"start":"4:1","end":"5:12","title":"Loss of the Ark and Death of Eli","setting":["ebenezer","aphek","shiloh","ashdod"],"on_stage_named":["eli","hophni","phinehas_eli","ichabod","phinehas_wife"],"on_stage_unnamed":["messengers","elders"],"mentioned_only":["samuel","yahweh"]},{"start":"6:1","end":"7:17","title":"Return of the Ark and Victory at Mizpah","setting":["beth_shemesh","kiriath_jearim","mizpah"],"on_stage_named":["samuel"],"on_stage_unnamed":["levites","lords_of_philistines"],"mentioned_only":["yahweh"]},{"start":"8:1","end":"10:27","title":"Demand for a King and Anointing of Saul","setting":["ramah","mizpah","gibeah"],"on_stage_named":["samuel","saul","kish","joel","abijah"],"on_stage_unnamed":["elders","servants"],"mentioned_only":["yahweh"]},{"start":"11:1","end":"12:25","title":"Saul Rescues Jabesh and Samuel's Farewell","setting":["jabesh_gilead","gibeah","gilgal"],"on_stage_named":["saul","samuel","nahash_ammonite"],"on_stage_unnamed":["messengers","people"],"mentioned_only":["yahweh"]},{"start":"13:1","end":"14:52","title":"Saul's Disobedience and Jonathan's Faith","setting":["gilgal","gibeah","michmash"],"on_stage_named":["saul","samuel","jonathan_saul","ahijah"],"on_stage_unnamed":["armor_bearer","watchmen"],"mentioned_only":["yahweh"]},{"start":"15:1","end":"16:13","title":"Rejection of Saul and Anointing of David","setting":["gilgal","ramah","bethlehem"],"on_stage_named":["saul","samuel","agag","david","jesse","eliab"],"on_stage_unnamed":["elders","sons_of_jesse"],"mentioned_only":["yahweh"]},{"start":"16:14","end":"17:58","title":"David Serves Saul and Kills Goliath","setting":["gibeah","valley_elah"],"on_stage_named":["saul","david","goliath","abner","jonathan_saul"],"on_stage_unnamed":["evil_spirit","shepherds"],"mentioned_only":["yahweh"]},{"start":"18:1","end":"19:24","title":"Friendship, Jealousy, and Flight","setting":["gibeah","ramah","naioth"],"on_stage_named":["david","jonathan_saul","saul","michal","merab","samuel"],"on_stage_unnamed":["servants","prophets"],"mentioned_only":["yahweh"]},{"start":"20:1","end":"21:15","title":"Covenant with Jonathan and Escape to Nob/Gath","setting":["gibeah","nob","gath"],"on_stage_named":["david","jonathan_saul","saul","ahimelech","doeg","achish"],"on_stage_unnamed":["boy","servants"],"mentioned_only":["yahweh"]},{"start":"22:1","end":"23:29","title":"Massacre at Nob and Pursuit in Wilderness","setting":["adullam_cave","gibeah","keilah","wilderness_ziph"],"on_stage_named":["david","saul","doeg","ahimelech","abiathar","jonathan_saul"],"on_stage_unnamed":["outlaws","ziphites"],"mentioned_only":["yahweh"]},{"start":"24:1","end":"26:25","title":"David Spares Saul Twice","setting":["en_gedi","wilderness_ziph"],"on_stage_named":["david","saul","abner","abishai"],"on_stage_unnamed":["men_of_david","soldiers"],"mentioned_only":["yahweh"]},{"start":"27:1","end":"28:25","title":"David Among Philistines and Saul Consults Witch","setting":["ziklag","gath","endor","mount_gilboa"],"on_stage_named":["david","saul","achish","witch_of_endor","samuel"],"on_stage_unnamed":["philistine_princes","two_men"],"mentioned_only":["yahweh"]},{"start":"29:1","end":"31:13","title":"Death of Saul and Jonathan","setting":["aphek","jezreel","mount_gilboa","beth_shan","jabesh_gilead"],"on_stage_named":["david","saul","jonathan_saul","achish","abner"],"on_stage_unnamed":["philistines","valiant_men"],"mentioned_only":["yahweh"]}],"brief":{"era":"Iron Age I (approx. 11th-10th century BCE). Late Bronze to Early Iron transition.","place":"Levant: Hill country of Ephraim/Benjamin, Shephelah (lowlands), Coastal Plain (Philistine pentapolis), Jordan Valley, Wilderness regions.","dress":"Men wear knee-length tunics (ketonet) with belts; wealthy or officials may have longer robes. Women wear long dresses with head coverings/veils. Priests wear linen ephods and breastplates. Kings/warriors wear armor (bronze/iron scale or mail), helmets, and carry spears/swords. David initially wears shepherd's tunic, then royal armor.","buildings_and_objects":"Tabernacle/Tent of Meeting structure (not stone temple yet) with bronze altar. Stone houses with flat roofs. Caves used as hideouts. Clay pots, jars, loaves of bread. Ark of the Covenant (gold-covered chest with cherubim). Weapons: Slings, staffs, swords, spears, javelins. Musical instruments: Harps, lyres, pipes.","depiction_rules":["Yahweh is never depicted visually; represent His presence via light, cloud, fire, or voice effects only.","The Ark of the Covenant should be shown as a gold-plated wooden chest with two winged cherubim on top, often carried on poles.","Samuel appears as an old man/prophet in later chapters, but as a young boy/teen in early chapters.","Goliath must be depicted as exceptionally tall (approx. 9 feet) and heavily armored in bronze.","Saul is tall and impressive but becomes disheveled and tormented in later scenes.","David is youthful, ruddy, and handsome; avoid depicting him as an adult warrior until after chapter 17.","Evil spirits are abstract manifestations (dark smoke/shadows), not human figures."]}}}