{
  "name": "visibible",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "convex:dev": "convex dev --env-file .env.convex.dev",
    "convex:dev:setup": "convex dev --configure existing --once --env-file .env.convex.dev",
    "convex:deploy:prod": "convex deploy --yes --env-file .env.convex.prod",
    "convex:deploy:prod:dry-run": "convex deploy --dry-run --env-file .env.convex.prod",
    "convex:env:list:dev": "convex env list --env-file .env.convex.dev",
    "convex:env:list:prod": "convex env list --env-file .env.convex.prod",
    "vercel:link": "npx vercel link",
    "vercel:env:pull:development": "npx vercel env pull .env.vercel.development.local --environment=development",
    "vercel:env:pull:preview": "npx vercel env pull .env.vercel.preview.local --environment=preview",
    "vercel:env:pull:production": "npx vercel env pull .env.vercel.prod.local --environment=production",
    "vercel:deploy:preview": "npx vercel",
    "vercel:deploy:production": "npx vercel --prod",
    "build": "npm run works:import && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "works:import": "tsx scripts/works/import.mts",
    "works:check": "tsx scripts/works/import.mts --check",
    "works:read": "tsx scripts/works/read.mts",
    "works:canon": "tsx scripts/works/canon.mts",
    "works:references": "tsx scripts/works/references.mts",
    "works:correct": "tsx scripts/works/correct.mts",
    "works:bible-hints": "tsx scripts/works/bible-hints.mts",
    "evals:images": "tsx scripts/evals/images.mts",
    "engine:retirement-inventory": "tsx scripts/engine/retirement-inventory.mts",
    "rehearse": "vitest run --reporter=default --reporter=json --outputFile=evals/rehearsal/latest.json src/lib/__tests__/engine-admission.test.ts src/lib/__tests__/preparation.test.ts src/lib/__tests__/moment-cast-contract.test.ts src/lib/__tests__/corrections.test.ts src/lib/__tests__/image-evals-generic.test.ts tests/convex/analysis.test.ts tests/convex/generation-intent.test.ts tests/convex/generic-provenance.test.ts tests/convex/art-style-library.test.ts tests/convex/image-reports.test.ts tests/convex/bulk-binding.test.ts tests/convex/rehearsal.test.ts src/app/api/__tests__/generate-image/credit-flow.test.ts src/app/api/__tests__/public-images/route.test.ts src/app/api/__tests__/feedback/route.test.ts src/app/api/__tests__/image-models/route.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.1",
    "@ai-sdk/react": "^3.0.3",
    "@vercel/analytics": "^1.6.1",
    "ai": "^6.0.3",
    "convex": "^1.31.2",
    "jose": "^6.1.0",
    "light-bolt11-decoder": "^3.2.0",
    "lucide-react": "^0.562.0",
    "neutral-cost": "^0.2.2",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "snstr": "^0.1.10",
    "zod": "^4.6.7"
  },
  "overrides": {
    "react-markdown": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "snstr": {
      "zod": "$zod"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.16",
    "convex-test": "0.0.41",
    "eslint": "^9",
    "eslint-config-next": "16.1.5",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.0.16"
  }
}
