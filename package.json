{
  "name": "visibible",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "convex:dev": "convex dev --env-file .env.convex.dev",
    "convex:dev:setup": "convex dev --configure existing --once --env-file .env.convex.dev",
    "convex:deploy:prod": "convex deploy --yes --env-file .env.convex.prod",
    "convex:deploy:prod:dry-run": "convex deploy --dry-run --env-file .env.convex.prod",
    "convex:env:list:dev": "convex env list --env-file .env.convex.dev",
    "convex:env:list:prod": "convex env list --env-file .env.convex.prod",
    "vercel:link": "npx vercel link",
    "vercel:env:pull:development": "npx vercel env pull .env.vercel.development.local --environment=development",
    "vercel:env:pull:preview": "npx vercel env pull .env.vercel.preview.local --environment=preview",
    "vercel:env:pull:production": "npx vercel env pull .env.vercel.prod.local --environment=production",
    "vercel:deploy:preview": "npx vercel",
    "vercel:deploy:production": "npx vercel --prod",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.1",
    "@ai-sdk/react": "^3.0.3",
    "@vercel/analytics": "^1.6.1",
    "ai": "^6.0.3",
    "bolt11": "^1.4.0",
    "convex": "^1.31.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.562.0",
    "neutral-cost": "^0.2.2",
    "next": "16.1.1",
    "openai": "^6.15.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "snstr": "^0.1.10",
    "zod": "^4.1.12"
  },
  "overrides": {
    "react-markdown": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5",
    "vitest": "^4.0.16"
  }
}
